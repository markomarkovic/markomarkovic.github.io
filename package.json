{
  "name": "okram.civokram.com",
  "description": "Personal site",
  "version": "0.0.1",
  "private": true,
  "devDependencies": {
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "qrcode": "1.5.4",
    "replace-in-files-cli": "4.0.0",
    "simple-git-hooks": "2.13.1",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3"
  },
  "scripts": {
    "build": "vite build",
    "build:vcard": "pnpx qrcode -t svg -o public/vcard.svg -q 0 < public/marko-markovic.vcard",
    "build:timestamp": "pnpx replace-in-files-cli --string __LAST_UPDATE__ --replacement `date -I` dist/index.html",
    "dev": "vite",
    "lint": "eslint . --fix",
    "prepare": "pnpx simple-git-hooks",
    "preview": "vite preview",
    "serve": "vite preview"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpx lint-staged"
  },
  "lint-staged": {
    "**/*.js": [
      "pnpm run lint"
    ]
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSpacing": true,
    "printWidth": 80,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5"
  }
}
